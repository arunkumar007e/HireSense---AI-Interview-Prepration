# JWT signing secret - REQUIRED, must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-characters

# Token lifetime in milliseconds (default 1 day)
JWT_EXPIRATION_MS=86400000

# AI provider: 'mock' (offline, no key needed) or 'openai'
AI_PROVIDER=mock

# OpenAI settings (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT_SECONDS=60

# Seeded administrator account (on first boot only)
APP_ADMIN_EMAIL=admin@hiresense.com
APP_ADMIN_PASSWORD=Admin@12345
APP_ADMIN_NAME=HireSense Admin